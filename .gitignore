# Project data
# Ignore data files here when needed, then negate any intentionally tracked samples.
# Example: *.csv
# Example: !sample-data.csv

# Operating systems
.DS_Store
Thumbs.db
Desktop.ini

# Editors
.idea/
.vscode/
*.swp
*.swo

# AI-tool local configuration; AGENTS.md remains tracked
.claude/
.claudecode/
.gemini/
.github-copilot/
.kimi/
.github/copilot-instructions.md
CLAUDE.md
CLAUDECODE.md
CONVENTIONS.md
GEMINI.md
KIMI.md
CODEX.md
CHATGPT.md

# Secrets and local environment
.env
.env.*
!.env.example
*.key
*.pem
*.p12
*.pfx

# Logs, caches, coverage, and temporary files
*.log
log.txt
logs.txt
logs/
*.cache
.cache/
coverage/
.coverage
tmp/
temp/

# R and RStudio
.Rproj.user/
*.Rproj
.RData
.RHistory
.Rhistory
.Ruserdata
.Rapp.history

# Node-based development tools
node_modules/
.npm/
.pnpm-store/

# Python-based validation helpers
__pycache__/
*.py[cod]
.venv/
